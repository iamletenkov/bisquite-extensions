[Unit]
Description=Verify hardware H.264 encoding for Selkies through V4L2 M2M
DefaultDependencies=no
# После сессии, потому что проверяются те же узлы, с которыми работает Selkies;
# но НЕ Requires — отказ проверки не должен гасить рабочий стол, он должен быть
# громко виден в журнале.
After=graphical.target display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/bisquite/pixelflux-v4l2m2m/configure.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=verify-pixelflux-v4l2m2m
TimeoutStartSec=120

[Install]
WantedBy=graphical.target
