#!/usr/bin/env bash
# bisquite-desktop — ручки рабочего стола: автологин, автоблокировка, затемнение.
#
#   bisquite-desktop set KEY=VALUE…       записать ручку и применить, если можно
#   bisquite-desktop apply [--boot|--now] применить то, что записано
#   bisquite-desktop defaults [KEY=VALUE…] записать ручки, не применяя
#   bisquite-desktop status               показать ручки и что из них применено
#   bisquite-desktop install <каталог>    поставить CLI и службу (install.sh расширения)
#
# Ручки — /etc/bisquite/desktop/config, домен `desktop` библиотеки
# bisquite-conf; схема (ключи, типы, умолчания) — lib/knobs/desktop:
#
#   DESKTOP_AUTOLOGIN=0             1 — вход без пароля
#   DESKTOP_AUTOLOGIN_USER=         пусто — пользователь cloud-init
#   DESKTOP_DISABLE_SCREEN_LOCK=0   1 — без автоблокировки (вручную — можно)
#   DESKTOP_DISABLE_SCREEN_BLANK=0  1 — без затемнения, гашения, DPMS и сна
#
# `bisquite-desktop set` — то же, что `bisquite-conf set --apply desktop`:
# хук desktop.apply применяет сразу, если менеджер входа уже работает.
#
# КТО ПРИМЕНЯЕТ. bisquite-desktop.service зовёт `apply --boot` на каждой
# загрузке ДО менеджера входа; `set` на работающей машине применяет сразу.
# Один код на gdm3 и lightdm, чтобы три расширения рабочего стола не
# расходились, как расходились их копии disable_powersave.sh.
set -uo pipefail

CONF=/etc/bisquite/desktop/config
# Path before 3.0.0. Not read as a fallback: install removes it so the
# image never carries two sources of truth.
LEGACY_CONF=/etc/default/bisquite-desktop
# Where this script really lives: /opt/bisquite/lib/<sha256>/, the shared code
# the build delivered next to the extension. /usr/local/sbin/bisquite-desktop is
# a symlink into it, so resolving the link finds get_cloud_user.sh of the SAME
# lib/ version — the CLI and the resolver it calls can never come from two
# different commits.
LIBDIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# Before layout 2 install copied the CLI's helper here. Not read as a fallback:
# install removes it so a base image built earlier leaves no stale copy behind.
LEGACY_LIBDIR=/usr/local/lib/bisquite-desktop
# The settings library of the same lib/: parsing, validation and writing of
# the knob file live there, not here.
# shellcheck source=/dev/null
source "$LIBDIR/bisquite-conf"

# Файлы, которыми владеет этот скрипт. Выключенная ручка = файла нет:
# тогда действует поведение ОС, а не наше «выключено».
DCONF_LOCK=/etc/dconf/db/local.d/50-bisquite-screen-lock
DCONF_LOCK_LOCKS=/etc/dconf/db/local.d/locks/50-bisquite-screen-lock
DCONF_BLANK=/etc/dconf/db/local.d/50-bisquite-screen-blank
DCONF_BLANK_LOCKS=/etc/dconf/db/local.d/locks/50-bisquite-screen-blank
DCONF_GDM_BLANK=/etc/dconf/db/gdm.d/50-bisquite-screen-blank
XSESSION_BLANK=/etc/X11/Xsession.d/90-bisquite-disable-dpms
XFCONF_DIR=/etc/xdg/xfce4/xfconf/xfce-perchannel-xml
XFCE_POWER="$XFCONF_DIR/xfce4-power-manager.bisquite.xml"
XFCE_SAVER="$XFCONF_DIR/xfce4-screensaver.bisquite.xml"

log(){ >&2 echo "bisquite-desktop: $*"; }
die(){ log "ОШИБКА: $*"; exit 1; }

# ---------------------------------------------------------------------------
# Файл ручек — через bisquite-conf: без `source`, со схемой lib/knobs/desktop.
# ---------------------------------------------------------------------------
load_conf(){
    conf_load desktop || die "ручки $CONF не прочитаны"
}

# ---------------------------------------------------------------------------
# Пользователь
# ---------------------------------------------------------------------------
resolve_user(){
    local wait_s="$1" user="" waited=0
    while :; do
        if [[ -n "$DESKTOP_AUTOLOGIN_USER" ]]; then
            user="$DESKTOP_AUTOLOGIN_USER"
        elif [[ -x "$LIBDIR/get_cloud_user.sh" ]]; then
            user="$("$LIBDIR/get_cloud_user.sh" 2>/dev/null || true)"
        fi
        if [[ -n "$user" ]] && id "$user" >/dev/null 2>&1 && [[ -d "$(getent passwd "$user" | cut -d: -f6)" ]]; then
            echo "$user"; return 0
        fi
        (( waited >= wait_s )) && return 1
        sleep 3; waited=$((waited + 3))
    done
}

# Группы — ДО сессии, и это главное, ради чего служба стоит перед
# менеджером входа. Xorg автологина запускается от имени пользователя;
# без `video` он не открывает GPU: «NVIDIA(GPU-0): Failed to initialize the
# NVIDIA graphics device!», 52 попытки, и gdm бросает автологин (первая
# загрузка Orin 2026-09-14; прежде группы вносил cloud-user-desktop уже
# после cloud-final, то есть после старта gdm). Драйвер дисплея тут ни при
# чём: nvidia-modeset подгружает сам X, когда открыл GPU (на удачной
# загрузке — через 0.5 с после старта Xorg).
#
# И вторая причина: `systemd --user` навсегда забирает список групп,
# который был на момент его старта (замер 2026-09-12: сессия без `video`
# даёт «Oh no! Something has gone wrong»). Внесённый заранее пользователь
# этой гонки не знает вовсе.
ensure_groups(){
    local user="$1" grp changed=0
    for grp in video render audio pulse input dialout plugdev; do
        getent group "$grp" >/dev/null 2>&1 || continue
        id -nG "$user" | tr ' ' '\n' | grep -qx "$grp" && continue
        if usermod -aG "$grp" "$user" 2>/dev/null; then
            log "'$user' внесён в группу $grp"; changed=1
        fi
    done
    return $(( changed ? 0 : 1 ))
}

# ---------------------------------------------------------------------------
# INI: ключ в своей секции (разбор трёх прежних дефектов — в истории
# cloud-user-desktop/configure.sh: закомментированный ключ, дописывание
# в чужую секцию, «успех» по факту вызова, а не записи).
# ---------------------------------------------------------------------------
set_ini_key(){
    local file="$1" section="$2" key="$3" value="$4" tmp
    tmp="$(mktemp)" || return 1
    awk -v want="$section" -v key="$key" -v value="$value" '
        function emit() { print key "=" value; done = 1 }
        /^[[:space:]]*\[/ {
            if (cur == want && !done) emit()
            line = $0; sub(/^[[:space:]]*\[/, "", line); sub(/\].*$/, "", line)
            cur = line; print; next
        }
        {
            if (cur == want && $0 ~ "^[[:space:]]*#*[[:space:]]*" key "[[:space:]]*=") {
                if (!done) emit()
                next
            }
            print
        }
        END { if (!done) { if (cur == want) emit(); else { print ""; print "[" want "]"; emit() } } }
    ' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
    cat "$tmp" > "$file"; rm -f "$tmp"
    grep -qxF "${key}=${value}" "$file"
}

del_ini_key(){
    local file="$1" key="$2"
    sed -i -E "/^[[:space:]]*${key}[[:space:]]*=/d" "$file"
}

lightdm_seat_section(){
    if grep -q '^[[:space:]]*\[SeatDefaults\]' "$1" && ! grep -q '^[[:space:]]*\[Seat:\*\]' "$1"; then
        echo 'SeatDefaults'
    else
        echo 'Seat:*'
    fi
}

# Какой файл читает gdm, решено при сборке пакета: Debian 13 —
# daemon.conf, Ubuntu — custom.conf (замер 2026-09-03). Правим все, какие есть.
gdm_confs(){
    local c
    for c in /etc/gdm3/daemon.conf /etc/gdm3/custom.conf; do [[ -f "$c" ]] && echo "$c"; done
}
lightdm_confs(){
    local c
    for c in /etc/lightdm/lightdm.conf /etc/lightdm/lightdm.conf.d/*.conf; do [[ -f "$c" ]] && echo "$c"; done
}

# ---------------------------------------------------------------------------
# Три ручки
# ---------------------------------------------------------------------------
apply_autologin(){
    local user="$1" conf section
    while read -r conf; do
        [[ -n "$conf" ]] || continue
        if [[ "$DESKTOP_AUTOLOGIN" == 1 ]]; then
            set_ini_key "$conf" daemon AutomaticLoginEnable true \
                && set_ini_key "$conf" daemon AutomaticLogin "$user" \
                || die "gdm: не записался автологин в $conf"
        else
            set_ini_key "$conf" daemon AutomaticLoginEnable false \
                || die "gdm: не записался отказ от автологина в $conf"
        fi
    done < <(gdm_confs)
    while read -r conf; do
        [[ -n "$conf" ]] || continue
        section="$(lightdm_seat_section "$conf")"
        if [[ "$DESKTOP_AUTOLOGIN" == 1 ]]; then
            set_ini_key "$conf" "$section" autologin-user "$user" \
                && set_ini_key "$conf" "$section" autologin-user-timeout 0 \
                || die "lightdm: не записался автологин в $conf"
        else
            del_ini_key "$conf" autologin-user
            del_ini_key "$conf" autologin-user-timeout
        fi
    done < <(lightdm_confs)
}

# Системная база dconf + locks: пользовательская база эти ключи не
# перебивает, то есть «навсегда» значит навсегда, а не до первой правки
# в настройках. Выключенная ручка снимает и значения, и locks.
dconf_profile(){
    install -d /etc/dconf/db/local.d/locks /etc/dconf/profile
    if [[ ! -f /etc/dconf/profile/user ]]; then
        printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
    elif ! grep -q '^system-db:local$' /etc/dconf/profile/user; then
        printf 'system-db:local\n' >> /etc/dconf/profile/user
    fi
}

apply_screen_lock(){
    if [[ "$DESKTOP_DISABLE_SCREEN_LOCK" == 1 ]]; then
        dconf_profile
        # Только АВТОблокировка. `org/gnome/desktop/lockdown/disable-lock-screen`
        # не трогаем: он запрещает и ручную блокировку, а ручная — право
        # пользователя. apps/light-locker — блокировщик xfce/lxde на Debian
        # и Ubuntu, он тоже читает GSettings.
        cat > "$DCONF_LOCK" <<'EOF'
[org/gnome/desktop/screensaver]
lock-enabled=false
ubuntu-lock-on-suspend=false

[apps/light-locker]
lock-after-screensaver=uint32 0
lock-on-suspend=false
lock-on-lid=false
EOF
        cat > "$DCONF_LOCK_LOCKS" <<'EOF'
/org/gnome/desktop/screensaver/lock-enabled
/org/gnome/desktop/screensaver/ubuntu-lock-on-suspend
/apps/light-locker/lock-after-screensaver
/apps/light-locker/lock-on-suspend
/apps/light-locker/lock-on-lid
EOF
    else
        rm -f "$DCONF_LOCK" "$DCONF_LOCK_LOCKS"
    fi
}

apply_screen_blank(){
    local conf section
    if [[ "$DESKTOP_DISABLE_SCREEN_BLANK" == 1 ]]; then
        dconf_profile
        cat > "$DCONF_BLANK" <<'EOF'
[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
idle-activation-enabled=false

[org/gnome/settings-daemon/plugins/power]
idle-dim=false
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
sleep-inactive-ac-timeout=0
sleep-inactive-battery-timeout=0
EOF
        cat > "$DCONF_BLANK_LOCKS" <<'EOF'
/org/gnome/desktop/session/idle-delay
/org/gnome/desktop/screensaver/idle-activation-enabled
/org/gnome/settings-daemon/plugins/power/idle-dim
/org/gnome/settings-daemon/plugins/power/sleep-inactive-ac-type
/org/gnome/settings-daemon/plugins/power/sleep-inactive-battery-type
EOF
        # Экран входа gdm читает СВОЙ профиль (profile/gdm → system-db:gdm),
        # пользовательские ключи до него не доходят.
        if [[ -f /etc/dconf/profile/gdm ]]; then
            install -d /etc/dconf/db/gdm.d
            cp "$DCONF_BLANK" "$DCONF_GDM_BLANK"
        fi
        # Уровень X — для любого сеанса на Xorg, включая xfce и lxde.
        install -d /etc/X11/Xsession.d
        cat > "$XSESSION_BLANK" <<'EOF'
# Положено bisquite-desktop (DESKTOP_DISABLE_SCREEN_BLANK=1).
if command -v xset >/dev/null 2>&1; then
    xset s off; xset s noblank; xset -dpms
fi
EOF
        if [[ -d "$XFCONF_DIR" || -x /usr/bin/xfce4-power-manager ]]; then
            install -d "$XFCONF_DIR"
            cat > "$XFCE_POWER" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-power-manager" version="1.0">
  <property name="xfce4-power-manager" type="empty">
    <property name="blank-on-ac" type="int" value="0"/>
    <property name="blank-on-battery" type="int" value="0"/>
    <property name="dpms-enabled" type="bool" value="false"/>
    <property name="inactivity-on-ac" type="uint" value="0"/>
    <property name="inactivity-on-battery" type="uint" value="0"/>
  </property>
</channel>
EOF
        fi
        # Экран входа lightdm гаснет сам по себе: X без -s 0 -dpms.
        while read -r conf; do
            [[ -n "$conf" ]] || continue
            section="$(lightdm_seat_section "$conf")"
            set_ini_key "$conf" "$section" xserver-command "X -s 0 -dpms" || true
        done < <(lightdm_confs)
    else
        rm -f "$DCONF_BLANK" "$DCONF_BLANK_LOCKS" "$DCONF_GDM_BLANK" "$XSESSION_BLANK" "$XFCE_POWER"
        while read -r conf; do
            [[ -n "$conf" ]] || continue
            grep -qE '^[[:space:]]*xserver-command=X -s 0 -dpms$' "$conf" && del_ini_key "$conf" xserver-command
        done < <(lightdm_confs)
    fi
}

dconf_update(){
    command -v dconf >/dev/null 2>&1 || return 0
    [[ -d /etc/dconf/db/local.d ]] || return 0
    dconf update || log "dconf update не прошёл — настройки блокировки и затемнения не применятся"
}

# xfce4-screensaver держит обе ручки в одном канале — поэтому отдельно,
# после обеих: гашение (saver) и блокировка (lock).
apply_xfce_screensaver(){
    if [[ "$DESKTOP_DISABLE_SCREEN_LOCK" != 1 && "$DESKTOP_DISABLE_SCREEN_BLANK" != 1 ]]; then
        rm -f "$XFCE_SAVER"; return 0
    fi
    [[ -d "$XFCONF_DIR" || -x /usr/bin/xfce4-screensaver ]] || return 0
    local saver=true lock=true
    [[ "$DESKTOP_DISABLE_SCREEN_BLANK" == 1 ]] && saver=false
    [[ "$DESKTOP_DISABLE_SCREEN_LOCK" == 1 ]] && lock=false
    install -d "$XFCONF_DIR"
    cat > "$XFCE_SAVER" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-screensaver" version="1.0">
  <property name="saver" type="empty">
    <property name="enabled" type="bool" value="${saver}"/>
  </property>
  <property name="lock" type="empty">
    <property name="enabled" type="bool" value="${lock}"/>
  </property>
</channel>
EOF
}

# lxsession запускает хранитель экрана из ~/.config/lxsession/LXDE/desktop.conf.
# Это файл пользователя, его пишет и сам lxsession, поэтому правим один ключ
# и ТОЛЬКО при включённой ручке; выключение ручки его не откатывает — назад
# пользователь переключает сам, в настройках сессии.
apply_lxsession(){
    local user="$1" home conf
    [[ "$DESKTOP_DISABLE_SCREEN_BLANK" == 1 && -n "$user" ]] || return 0
    command -v lxsession >/dev/null 2>&1 || return 0
    home="$(getent passwd "$user" | cut -d: -f6)"
    conf="$home/.config/lxsession/LXDE/desktop.conf"
    install -d -o "$user" -g "$user" "$home/.config" "$home/.config/lxsession" "$home/.config/lxsession/LXDE"
    [[ -f "$conf" ]] || printf '[Session]\nwindow_manager=openbox-lxde\n' > "$conf"
    set_ini_key "$conf" Startup screensaver disabled || log "lxsession: не записался screensaver=disabled"
    chown "$user:$user" "$conf"
}

# Имена файлов xfconf выше — с суффиксом .bisquite: xfconf читает только
# <канал>.xml. Симлинк на наш файл ставится, лишь если канала нет вовсе,
# чтобы не затирать то, что положил пакет или администратор.
link_xfconf(){
    local f base
    for f in "$XFCE_POWER" "$XFCE_SAVER"; do
        base="${f%.bisquite.xml}.xml"
        if [[ -f "$f" ]]; then
            [[ -e "$base" ]] || ln -s "$(basename "$f")" "$base"
        elif [[ -L "$base" && "$(readlink "$base")" == "$(basename "$f")" ]]; then
            rm -f "$base"
        fi
    done
}

# ---------------------------------------------------------------------------
# Сессия
# ---------------------------------------------------------------------------
graphical_user_session(){
    local sid class type
    for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
        class="$(loginctl show-session "$sid" -p Class --value 2>/dev/null)"
        type="$(loginctl show-session "$sid" -p Type --value 2>/dev/null)"
        [[ "$class" == user && ( "$type" == x11 || "$type" == wayland ) ]] && return 0
    done
    return 1
}

active_dm(){
    local dm
    for dm in gdm3 gdm lightdm; do
        systemctl is-active "$dm.service" >/dev/null 2>&1 && { echo "$dm"; return 0; }
    done
    return 1
}

dm_fingerprint(){ { gdm_confs; lightdm_confs; } | xargs -r cat 2>/dev/null | md5sum | cut -c1-32; }

cmd_apply(){
    local mode="${1:---now}" user="" wait_s=0 before after dm
    load_conf
    if [[ "$DESKTOP_AUTOLOGIN" == 1 ]]; then
        # Пользователя создаёт cloud-init.service, и служба стоит после него,
        # то есть обычно он уже есть. Короткое ожидание — страховка на случай,
        # когда userdata ещё не дочитана; длинное превратилось бы в чёрный
        # экран, а экран входа лучше.
        [[ "$mode" == --boot ]] && wait_s=30
        user="$(resolve_user "$wait_s")" || { log "пользователь для автологина не найден — автологин не включаю"; DESKTOP_AUTOLOGIN=0; }
    else
        user="$(resolve_user 0)" || user=""
    fi
    [[ -n "$user" ]] && ensure_groups "$user" || true

    before="$(dm_fingerprint)"
    apply_autologin "$user"
    apply_screen_lock
    apply_screen_blank
    apply_xfce_screensaver
    apply_lxsession "$user"
    link_xfconf
    dconf_update
    after="$(dm_fingerprint)"
    log "автологин=$DESKTOP_AUTOLOGIN${user:+ ($user)} блокировка_выкл=$DESKTOP_DISABLE_SCREEN_LOCK затемнение_выкл=$DESKTOP_DISABLE_SCREEN_BLANK"

    [[ "$mode" == --now ]] || return 0
    [[ "$before" == "$after" ]] && return 0
    dm="$(active_dm)" || return 0
    # Чужую сессию не обрываем: правка автологина подождёт перезагрузки.
    if graphical_user_session; then
        log "открыта графическая сессия — $dm не перезапускаю, автологин применится со следующей загрузки"
        return 0
    fi
    log "перезапускаю $dm, чтобы автологин применился сейчас"
    # --no-block: `set` бывает внутри cloud-final и guestfs-firstboot, а
    # блокирующий перезапуск оттуда — взаимная блокировка (валидатор хуков).
    systemctl --no-block restart "$dm.service" || log "$dm не перезапустился"
}

# `set` — проверка и запись библиотекой, применение — хуком desktop.apply,
# то есть `apply --set` ниже. --apply: хук зовётся и во время загрузки, как
# это делал `set` до библиотеки; сам хук безопасен — он смотрит, работает ли
# менеджер входа, и перезапускает его без ожидания.
cmd_set(){
    (( $# )) || die "set: нужен хотя бы один KEY=VALUE"
    conf_cli_set --apply desktop "$@" || exit 1
}

# Хук применения: менеджер входа ещё не запущен (FIRSTBOOT_COMMAND, compose) —
# применит bisquite-desktop.service перед его стартом, и пользователя он дождётся.
cmd_apply_set(){
    if active_dm >/dev/null; then
        cmd_apply --now
    else
        log "записано в $CONF; применится при старте менеджера входа"
    fi
}

# Юнит — в теле скрипта, а не отдельным файлом: так его несёт тот же lib/,
# и четыре расширения не могут разойтись в порядке запуска.
write_unit(){
    cat > /etc/systemd/system/bisquite-desktop.service <<'EOF'
[Unit]
Description=Apply bisquite desktop knobs (autologin, screen lock, blanking)
# ПОСЛЕ cloud-init.service: там создаётся пользователь cloud-init, а gdm по
# цепочке и так стоит после него (systemd-user-sessions After=cloud-init) —
# нового ребра для менеджера входа это не добавляет. НЕ cloud-config и не
# cloud-final: первый ждёт snapd.seeded, второй стоит после multi-user; связка
# с cloud-final уже дважды давала молчаливый цикл, и systemd выбрасывал gdm.
After=cloud-init.service
# FIRSTBOOT_COMMAND из VMFILE и firstboot_commands compose исполняет
# guestfs-firstboot — `bisquite-desktop set` там успевает записать ручку.
After=guestfs-firstboot.service
Before=display-manager.service gdm.service gdm3.service lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/bisquite-desktop apply --boot
SyslogIdentifier=bisquite-desktop
TimeoutStartSec=90

[Install]
WantedBy=graphical.target
EOF
}

# `install <каталог расширения>` — на сборке образа. Внутри virt-customize
# systemd не работает, поэтому включение — ссылкой, а не `systemctl enable`.
#
# CLI ставится ССЫЛКОЙ /usr/local/sbin/bisquite-desktop ->
# <каталог>/lib/bisquite-desktop, а не копией. Копии в /usr/local/sbin
# не на кого опереться: get_cloud_user.sh лежит в lib/ рядом с оригиналом, и
# копии пришлось бы вписывать путь с именем расширения — то есть ещё один
# путь, который расходится. Ссылка же ведёт в каталог расширения, который
# остаётся в образе (из него работают и юниты), и через него — в тот lib/,
# с которым расширение ставили. В цепочке FROM последнее расширение рабочего
# стола перенаправляет ссылку на свой lib/; ручки в /etc/bisquite/desktop
# при этом не трогаются.
# Умолчания ручек — из переменных окружения DESKTOP_*, если заданы
# (`EXTENSION gnome DESKTOP_AUTOLOGIN=1`): conf_init --env берёт только ключи
# схемы и только экспортированные, прочие ключи файла не трогает.
cmd_install(){
    local src="${1:-}" k pairs=()
    [[ -d "$src" ]] || die "install: нужен каталог расширения"
    # Абсолютный: путь уходит в ссылку и должен значить то же на устройстве.
    [[ "$src" == /* ]] || die "install: путь каталога расширения должен быть абсолютным: '$src'"
    [[ -x "$src/lib/bisquite-desktop" ]] || die "install: нет $src/lib/bisquite-desktop — сборка не доставила lib/ источника"
    [[ -x "$src/lib/get_cloud_user.sh" ]] || die "install: нет $src/lib/get_cloud_user.sh — сборка не доставила lib/ источника"
    [[ -f "$src/lib/knobs/desktop" ]] || die "install: нет $src/lib/knobs/desktop — сборка не доставила lib/ источника"
    if [[ -e "$LEGACY_CONF" ]]; then
        log "удаляю $LEGACY_CONF: ручки теперь в $CONF, прежний файл не читается"
        rm -f "$LEGACY_CONF"
    fi
    if [[ -e "$LEGACY_LIBDIR" ]]; then
        log "удаляю $LEGACY_LIBDIR: общий код теперь в lib/ расширения"
        rm -rf "$LEGACY_LIBDIR"
    fi
    install -d -m 0755 /usr/local/sbin
    # -n: не заходить внутрь, если на месте уже ссылка; -f: заменить прежнюю
    # копию из образа до раскладки 2.
    ln -sfn "$src/lib/bisquite-desktop" /usr/local/sbin/bisquite-desktop
    write_unit
    install -d /etc/systemd/system/graphical.target.wants
    ln -sf /etc/systemd/system/bisquite-desktop.service /etc/systemd/system/graphical.target.wants/bisquite-desktop.service
    # Схема и хук регистрируются через каталог расширения, как и сам CLI.
    # Файл ручек не перезаписывается: недостающие ключи дописываются,
    # заданные остаются — второе расширение рабочего стола не сбросит то,
    # что задало первое, а повторная установка — правки оператора.
    conf_init desktop "$src/lib/knobs/desktop" --env || die "ручки рабочего стола не записаны"
    load_conf
    for k in $(conf_keys desktop); do pairs+=("$k=${!k}"); done
    log "установлен; ручки: ${pairs[*]}"
}

cmd_defaults(){
    (( $# )) || return 0
    conf_set desktop "$@" || exit 1
}

cmd_status(){
    load_conf
    local k
    for k in $(conf_keys desktop); do printf '%s=%s\n' "$k" "${!k}"; done
    printf 'dconf блокировка: %s; dconf затемнение: %s; X DPMS: %s\n' \
        "$([[ -f $DCONF_LOCK ]] && echo да || echo нет)" \
        "$([[ -f $DCONF_BLANK ]] && echo да || echo нет)" \
        "$([[ -f $XSESSION_BLANK ]] && echo да || echo нет)"
}

case "${1:-}" in
    set) shift; [[ $EUID -eq 0 ]] || die "нужен root"; cmd_set "$@" ;;
    apply) shift; [[ $EUID -eq 0 ]] || die "нужен root"
        if [[ "${1:-}" == --set ]]; then cmd_apply_set; else cmd_apply "${1:---now}"; fi ;;
    defaults) shift; [[ $EUID -eq 0 ]] || die "нужен root"; cmd_defaults "$@" ;;
    install) shift; [[ $EUID -eq 0 ]] || die "нужен root"; cmd_install "$@" ;;
    status) cmd_status ;;
    *) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
