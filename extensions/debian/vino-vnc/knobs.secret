#!/usr/bin/env bash
# Secret hook of the vino domain: VINO_PASSWORD on stdin -> base64 file.
#
# The vnc-password key of org.gnome.Vino stores the password in base64 (its
# description says so). base64 is trivially reversible, so the file is the
# secret: 0600 in a 0700 directory, read by root's configure.sh only.
set -euo pipefail

root="${BISQUITE_CONF_ROOT:-}"
passfile=/etc/vino/vnc-password.b64
err(){ >&2 echo "vino.secret: $*"; exit 1; }

[[ "${1:-}" == VINO_PASSWORD ]] || err "неизвестный ключ '${1:-}'"
IFS= read -r -d '' pass || true

if [[ -z "$pass" ]]; then
    rm -f "$root$passfile"
    echo "VINO_PASSWORD_FILE="
    exit 0
fi

install -d -m 0700 "$root/etc/vino"
tmp="$(mktemp "$root/etc/vino/.vnc-password.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
chmod 0600 "$tmp"
printf '%s' "$pass" | base64 -w0 > "$tmp" || err "не записан файл пароля"
mv -f "$tmp" "$root$passfile"
trap - EXIT
if (( ${#pass} > 8 )); then
    # RFB type 2 authentication feeds exactly 8 bytes into DES; the rest is
    # dropped. A twenty-character password is no stronger than eight.
    >&2 echo "vino.secret: пароль длиннее 8 символов: VNC-аутентификация использует только первые 8"
fi
echo "VINO_PASSWORD_FILE=$passfile"
