# Плата: NVIDIA Jetson AGX Xavier Developer Kit (p2972-0000).
#   модуль p2888-0001 (16 ГБ), несущая p2822-0000, SoC Tegra194.
#   Потолок — JetPack 5.1.7 / L4T 35.6.5; JetPack 6 на t194 не выходил.
#
# QSPI у платы НЕТ: загрузчик и раздел esp лежат во внутренней eMMC. Внешний
# носитель грузится ТОЛЬКО после прошивки eMMC (NVIDIA: «can boot from a USB or
# an NVMe drive only if the internal eMMC has been flashed»). Горячее
# подключение не поддерживается.
SOC=t194
BOARD_TARGET=jetson-agx-xavier-devkit
# Значения для offline-режима ИЗМЕРЕНЫ на плате 2026-09-18: TNSPEC, записанный
# вендорской прошивкой, — 2888-400-0001-J.0. Таблица в README NVIDIA даёт для
# этой платы H.0 — это пример ревизии, а не наша.
BOARDID=2888
FAB=400
BOARD_SKU=0001
BOARDREV=J.0
# Ревизия в терминах creator'а (-r) — у этой платы единственное значение.
BOARD_REVISION=default
# Что creator впишет в root= — потом шаг 08 заменит на PARTUUID.
ROOTFS_DEV=USB
# Отдельной кнопки «только загрузчик» у eMMC нет: пакет полный, с rootfs.
BOOTLOADER_PACKAGE=full
# Packaging and flashing tool: l4t_initrd_flash.sh --massflash offline, then
# --flash-only from the package.
BOOTLOADER_TOOL=initrd-flash
FLASH_XML=tools/kernel_flash/flash_l4t_t194_nvme.xml
QSPI_CFG=
QSPI_TARGET=
# USB product ID of the board in recovery (lsusb: 0955:7019, AGX Xavier (t194) APX).
# Step 14 flashes only when exactly this one NVIDIA device is present.
RCM_USB_ID=7019
