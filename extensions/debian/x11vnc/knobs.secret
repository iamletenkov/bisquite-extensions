#!/usr/bin/env bash
# Secret hook of the x11vnc domain: X11VNC_PASSWORD on stdin -> rfbauth file.
#
# The -rfbauth format is NOT a hash: the password is DES-encrypted with a fixed
# key, so the file is the password. Hence 0600, and the owner is the user the
# server runs as (`x11vnc@<user>`, User=%i) — a root-owned 0600 file would make
# run-x11vnc.sh refuse to start, never fall back to -nopw. On the build the
# user does not exist yet: the file stays root's and configure.sh hands it over
# on first boot (hand_over_passfile).
#
# Prints the derived pair; bisquite-conf writes it. Any failure: non-zero exit,
# nothing printed, the library writes nothing — an image that looks
# password-protected but starts with -nopw is impossible.
set -euo pipefail

root="${BISQUITE_CONF_ROOT:-}"
passfile=/etc/x11vnc/passwd
err(){ >&2 echo "x11vnc.secret: $*"; exit 1; }

[[ "${1:-}" == X11VNC_PASSWORD ]] || err "неизвестный ключ '${1:-}'"
IFS= read -r -d '' pass || true

if [[ -z "$pass" ]]; then
    rm -f "$root$passfile"
    echo "X11VNC_PASSFILE="
    exit 0
fi
command -v x11vnc >/dev/null 2>&1 || err "нет x11vnc — пароль записать нечем"

# The directory stays 0755: the server user has to walk through it to the
# file. The secret is closed by the file's mode, not the directory's.
install -d -m 0755 "$root/etc/x11vnc"
tmp="$(mktemp "$root/etc/x11vnc/.passwd.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
chmod 0600 "$tmp"
# -storepasswd takes the password as an argument only; it is visible in
# /proc for the lifetime of this short call, never in bisquite-conf's argv.
x11vnc -storepasswd "$pass" "$tmp" >/dev/null 2>&1 || err "x11vnc -storepasswd не записал файл пароля"
[[ -s "$tmp" ]] || err "x11vnc -storepasswd оставил пустой файл"

# The enabled instance tells who reads the file on a running machine.
shopt -s nullglob
users=()
for unit in "$root"/etc/systemd/system/graphical.target.wants/x11vnc@*.service; do
    u="${unit##*/x11vnc@}"; users+=("${u%.service}")
done
shopt -u nullglob
if (( ${#users[@]} == 1 )) && id "${users[0]}" >/dev/null 2>&1; then
    chown "${users[0]}" "$tmp" || err "не передать файл пароля пользователю '${users[0]}'"
fi
mv -f "$tmp" "$root$passfile"
trap - EXIT
echo "X11VNC_PASSFILE=$passfile"
