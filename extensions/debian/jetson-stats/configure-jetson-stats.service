[Unit]
Description=Configure jetson-stats (jtop) for the cloud-init user
# Пользователя создаёт cloud-init: до него в группу вносить некого.
# Сам скрипт всё равно ждёт его циклом — упорядочивание сокращает ожидание,
# но не заменяет проверку.
# ПОСЛЕ cloud-final, а не cloud-init.
#
# `cloud-init.service` — вторая стадия из четырёх, и пользователя на ней
# ещё нет: его создаёт `cloud-config`, а заканчивает всё `cloud-final`.
# Замер 2026-09-06 на Jetson Nano: службы с `After=cloud-init.service`
# отсчитывали 40 попыток по 3 секунды и сдавались ЗА ДВЕ СЕКУНДЫ до
# финиша `cloud-final`.
After=cloud-final.service
Wants=cloud-final.service
# jtop.service поднимается сам (WantedBy=multi-user.target у upstream-юнита);
# нам нужно лишь оказаться после него, чтобы `systemctl start` не гонялся
# с штатным запуском.
# `After=jtop.service` УБРАН, и это починка, а не упрощение.
#
# Он давал гарантированный цикл: наш юнит объявлен `WantedBy=multi-user.target`,
# а вендорский `jtop.service` — `After=multi-user.target`. Кольцо
# `multi-user.target → configure-jetson-stats → jtop.service → multi-user.target`
# systemd разрывает, МОЛЧА выбрасывая нашу задачу:
#
#     multi-user.target: Found ordering cycle on configure-jetson-stats.service
#     Job configure-jetson-stats.service/start deleted to break ordering cycle
#
# Замер 2026-09-04 на живом Jetson Nano: служба не выполнялась ни разу,
# и в журнале это одна строка, которую легко пропустить.
#
# Встать «после jtop, но внутри multi-user» невозможно по построению:
# jtop намеренно поднимается ПОСЛЕ таргета. Дожидаться его и не нужно —
# `configure.sh` работает с уже установленным пакетом и группой `jtop`,
# а не с запущенной службой.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/vmsetup/jetson-stats/configure.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=configure-jetson-stats
TimeoutStartSec=300

[Install]
# ПРИВЯЗКА К cloud-init.target, А НЕ К multi-user.target.
#
# С `After=cloud-final.service` привязка к multi-user даёт цикл, потому
# что сам `cloud-final` объявлен `After=multi-user.target`:
#
#     multi-user.target → тянет эту службу → ждёт cloud-final
#                       → ждёт multi-user.target
#
# systemd разрывает кольцо, МОЛЧА выбрасывая нашу задачу. Замер
# 2026-09-06 на Jetson Nano: так выбросило сразу три службы.
#
# Это та же форма, что была с `After=jtop.service`; исправляя её,
# я подставил её же с другой стороны, не проверив упорядочение
# `cloud-final`. Проверка теперь записана здесь.
#
# `cloud-init.target` для этого и существует: он объявлен
# `After=cloud-final.service`, то есть достигается уже после того,
# как cloud-init закончил всё.
WantedBy=cloud-init.target
