# Board: NVIDIA Jetson Nano Developer Kit — module p3448-0000 (SD card),
# carrier p3449-0000 B01, SoC Tegra210.
# EEPROM measured on the live board 2026-09-19: module 699-13448-0000-400 F.0,
# carrier 699-13449-0000-400 D.0.
SOC=t210
# QSPI only, NO_ROOTFS=1. NOT jetson-nano-qspi-sd or jetson-nano-devkit: their
# layout carries <device type="sdcard"> with APP, and a package built from
# them would describe writing the SD card. Step 11 refuses any other target.
BOARD_TARGET=jetson-nano-qspi
BOARDID=3448
# FAB 300 and 400 build byte-identical boot images (DTB class b00); only VER
# differs. The EEPROM says 400.
FAB=400
BOARD_SKU=0000
# On t210 BOARDREV only goes into the spec string.
BOARDREV=F.0
# Creator -r for R32 (B00). Unused while the system is a vendor image.
BOARD_REVISION=300
ROOTFS_DEV=
# The bootloader lives in the module's QSPI-NOR.
BOOTLOADER_PACKAGE=qspi-only
# R32 for t210 has no tools/kernel_flash/: nvmassflashgen.sh builds the
# package, the package's own nvmflash.sh flashes it.
BOOTLOADER_TOOL=nvmassflashgen
FLASH_XML=
QSPI_CFG=bootloader/t210ref/cfg/flash_l4t_t210_max-spi_p3448.xml
QSPI_TARGET=jetson-nano-qspi
