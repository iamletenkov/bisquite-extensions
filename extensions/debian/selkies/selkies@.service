[Unit]
Description=Selkies web remote desktop for user %i
After=graphical.target display-manager.service
Requires=display-manager.service

[Service]
Type=simple
User=%i
EnvironmentFile=-/etc/bisquite/selkies/config
# Ждать сессию обёртка умеет сама и отказывает громко — см. её шапку.
ExecStart=/bin/bash /opt/bisquite/selkies/run-selkies.sh %i
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
