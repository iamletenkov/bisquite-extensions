[Unit]
Description=Finish installing the chromium snap after network is online
# Мягкая подсказка порядку: реальное ожидание делает сам configure.sh
# через `snap wait system seed.loaded`, а не эта строка. Wants, а не
# Requires — отсутствие snapd.seeded.service не должно ронять юнит,
# только вопрос очерёдности.
After=network.target network-online.target snapd.seeded.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/vmsetup/chromium/configure.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=configure-chromium
# Установка snap-пакета chromium — сотни мегабайт; на медленной сети
# и повторах install_snap (см. configure.sh) это может занять минуты.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
