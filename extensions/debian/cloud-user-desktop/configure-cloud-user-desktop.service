[Unit]
Description=Point desktop autologin at the cloud-init user
# ПОСЛЕ cloud-final, а не cloud-init.
#
# `cloud-init.service` — вторая стадия из четырёх, и пользователя на ней
# ещё нет: его создаёт `cloud-config`, а заканчивает всё `cloud-final`.
# Замер 2026-09-06 на Jetson Nano: службы, объявленные `After=cloud-init`,
# сдавались за две секунды до финиша `cloud-final`.
After=cloud-final.service
Wants=cloud-final.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/vmsetup/cloud-user-desktop/configure.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=configure-cloud-user-desktop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
