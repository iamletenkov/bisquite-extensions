# Release: Jetson Linux R32.7.4 (JetPack 4.6.4), Tegra210 only here.
# File names start with a capital letter (Jetson-210_Linux_R32.7.4), so
# SHA_GREP differs from R35+.
SOCS="t210"
BSP_URL=https://developer.download.nvidia.com/embedded/L4T/r32_Release_v7.4/T210/Jetson-210_Linux_R32.7.4_aarch64.tbz2
RFS_URL=https://developer.download.nvidia.com/embedded/L4T/r32_Release_v7.4/T210/Tegra_Linux_Sample-Root-Filesystem_R32.7.4_aarch64.tbz2
SHA_URL=https://developer.download.nvidia.com/embedded/L4T/r32_Release_v7.4/T210/release_sha_hashes.txt
# From NVIDIA's release_sha_hashes.txt; the downloaded BSP matched 2026-09-19.
BSP_SHA1=66ba218a9a60373dbbf00e5724fb66e40d1f527c
RFS_SHA1=7411aa14feeaf06e0d4dc712004dd3a4f2433b75
SHA_GREP='Jetson-210_Linux_R32\.7\.4|Sample-Root-Filesystem_R32\.7\.4'
BSP_FILE=Jetson-210_Linux_R32.7.4_aarch64.tbz2
RFS_FILE=Tegra_Linux_Sample-Root-Filesystem_R32.7.4_aarch64.tbz2
OV_QSPI_URL=
OV_QSPI_FILE=
OV_CAM_URL=
OV_CAM_FILE=
CAMERA_PKG_REL=
L4T_TAG=L4TR32.7.4
# The R32 creator has no -d flag.
CREATOR_HAS_DEV_FLAG=no
# NVIDIA names 18.04 for R32. The package was built on 22.04 (2026-09-19);
# flashing from 22.04 is untested, step 14 prints a warning.
FLASH_HOSTS="18.04"
