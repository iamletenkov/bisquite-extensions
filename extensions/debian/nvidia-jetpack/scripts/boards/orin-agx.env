# Профиль платы: NVIDIA Jetson AGX Orin Developer Kit.
#   модуль p3701-0000 (32 ГБ), несущая p3737-0000, JetPack 6.2 / L4T 36.4.3
#
# Подаётся окружением, а не правкой скриптов:
#
#     set -a; . /opt/nvidia-jetpack/boards/orin-agx.env; set +a
#     sudo -E /opt/nvidia-jetpack/09-build-jetson-base.sh -t jetson-orin-bsp:36.4.3
#
# Значения здесь совпадают с умолчаниями самих скриптов — профиль их не
# меняет, а ОБЪЯВЛЯЕТ. Смысл в том, чтобы «что именно собирается» читалось
# в одном файле, а не собиралось по десяти скриптам.

WORK="${WORK:-/srv/jetson}"

# --- шаг 01: откуда берётся L4T ---------------------------------------------
BSP_URL=https://developer.nvidia.com/downloads/embedded/l4t/r36_release_v4.3/release/Jetson_Linux_r36.4.3_aarch64.tbz2
RFS_URL=https://developer.nvidia.com/downloads/embedded/l4t/r36_release_v4.3/release/Tegra_Linux_Sample-Root-Filesystem_r36.4.3_aarch64.tbz2
SHA_URL=https://developer.nvidia.com/downloads/embedded/l4t/r36_release_v4.3/release/release_sha_hashes.txt
BSP_SHA1=3eb3c5a19a417313383c3bce297e07274a237e36
RFS_SHA1=0bdb4e655d48bdf7e7bd98d3b7b69480576bfd7e
SHA_GREP='Jetson_Linux_R?36\.4\.3|Sample-Root-Filesystem_R?36\.4\.3'

# Оверлей QSPI чинит тайминги mb1, без него прошивка QSPI бессмысленна.
OV_QSPI_URL=https://developer.nvidia.com/downloads/embedded/L4T/overlay_mb1bct_36.x.tbz2
QSPI_OVERLAY_DTS=tegra234-mb1-bct-device-p3701-0000.dts
# Оверлей камер — одна библиотека ISP, подменяется на шаге 03.
OV_CAM_URL=https://developer.nvidia.com/downloads/embedded/L4T/r36_Release_v4.3/overlay_camera_36.4.3.tbz2

# --- шаг 03: имена уже скачанных файлов -------------------------------------
BSP_FILE=Jetson_Linux_r36.4.3_aarch64.tbz2
RFS_FILE=Tegra_Linux_Sample-Root-Filesystem_r36.4.3_aarch64.tbz2
OV_QSPI_FILE=overlay_mb1bct_36.x.tbz2
OV_CAM_FILE=overlay_camera_36.4.3.tbz2

# --- шаги 02 и 04: камеры Sensing -------------------------------------------
CAMERA_PKG_REL='Jetson AGX Orin Devkit/SG8A-AGON-G2Y-A1/JetPack6.2/SG8A_AGON_G2Y_A1_AGX_Orin_GMSL2x8_JP6.2_L4TR36.4.3'
L4T_TAG=L4TR36.4.3

# --- шаги 05, 06, 08, 10: чем прошивать и что собирать ----------------------
BOARD_TARGET=jetson-agx-orin-devkit
# SKU модуля. Печатает любой прогон flash.sh с платой в recovery:
#   Board ID(3701) version(500) sku(0000) revision(J.0)
BOARD_SKU=0000
BOARD_REVISION=default
FLASH_XML=tools/kernel_flash/flash_l4t_t234_nvme.xml
QSPI_CFG=bootloader/generic/cfg/flash_t234_qspi.xml
QSPI_TARGET=p3737-0000-p3701-0000-qspi
ROOTFS_DEV=USB
OUT_RAW="$WORK/jetson-orin-bsp.img"
OUT_QCOW2="$WORK/jetson-orin-bsp.qcow2"
