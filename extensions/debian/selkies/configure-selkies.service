[Unit]
Description=Configure Selkies for the cloud-init user
DefaultDependencies=no
After=graphical.target display-manager.service
Requires=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/vmsetup/selkies/configure.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=configure-selkies
TimeoutStartSec=300

[Install]
WantedBy=graphical.target
