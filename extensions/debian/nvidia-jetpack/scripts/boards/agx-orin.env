# Плата: NVIDIA Jetson AGX Orin Developer Kit.
#   модуль p3701-0000, несущая p3737-0000, SoC Tegra234.
SOC=t234
BOARD_TARGET=jetson-agx-orin-devkit
# Значения из EEPROM модуля: 699-13701-0000-500 J.0 (замер 2026-09-18).
# TNSPEC на плате, прошитой НАШИМ образом, пишет FAB=default — это запись
# нашего же сборщика, а не платы; источником он не годится.
BOARDID=3701
FAB=500
BOARD_SKU=0000
BOARDREV=J.0
BOARD_REVISION=default
ROOTFS_DEV=USB
# Загрузчик в QSPI модуля — пакет ограничивается им (но rootfs в архив
# massflash всё равно кладёт, см. спеку).
BOOTLOADER_PACKAGE=qspi-only
# Packaging and flashing tool: l4t_initrd_flash.sh --massflash offline, then
# --flash-only from the package.
BOOTLOADER_TOOL=initrd-flash
FLASH_XML=tools/kernel_flash/flash_l4t_t234_nvme.xml
QSPI_CFG=bootloader/generic/cfg/flash_t234_qspi.xml
QSPI_TARGET=p3737-0000-p3701-0000-qspi
# USB product ID of the board in recovery (lsusb: 0955:7023, AGX Orin (t234) APX).
# Step 14 flashes only when exactly this one NVIDIA device is present.
RCM_USB_ID=7023
